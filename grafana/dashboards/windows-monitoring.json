{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "100 - (avg by (instance) (rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}]
    },
    {
      "title": "Available Memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "windows_memory_available_bytes / 1024 / 1024 / 1024", "legendFormat": "{{instance}}", "refId": "A"}]
    },
    {
      "title": "Disk Free Space",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "windows_logical_disk_free_bytes / 1024 / 1024 / 1024", "legendFormat": "{{instance}} {{volume}}", "refId": "A"}]
    },
    {
      "title": "System Uptime",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "windows_system_system_up_time", "legendFormat": "{{instance}}", "refId": "A"}]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["windows", "prometheus", "grafana"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Windows Monitoring",
  "uid": "windows-monitoring",
  "version": 1
}
